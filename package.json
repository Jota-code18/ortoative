{
  "name": "ortoative",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "imagens:avif": "node scripts/imagens-avif.mjs --limpar",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "biome check --write",
    "format:check": "biome check",
    "knip": "knip",
    "arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "commit:check": "commitlint --from=origin/main --to=HEAD --verbose",
    "test:mutacao": "stryker run",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm run knip && npm run arquitetura && npm run test:cobertura && npm run build",
    "modelos:otimizar": "node scripts/modelos-otimizar.mjs --escrever",
    "passeios:gravar": "node scripts/gravar-passeios.mjs"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@vercel/otel": "^2.1.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.2.0",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "knip": "^6.32.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
